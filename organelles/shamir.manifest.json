{
  "authority": {
    "declared_valence": "candidate",
    "granted_capabilities": [
      "bin.shamir.split",
      "bin.shamir.combine"
    ],
    "mutation_class": "write",
    "required_capability": null
  },
  "codon": "bm",
  "contracts": [
    {
      "description": "Split a secret file into SLIP-0039 mnemonic shares (input via FILE PATH only)",
      "input_schema": {
        "properties": {
          "secret_path": {
            "type": "string"
          },
          "shares": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "mutation_class": "write",
      "op": "split",
      "required_capability": "bin.shamir.split"
    },
    {
      "description": "Combine SLIP-0039 mnemonic shares back into the secret (shares via FILE PATH only)",
      "input_schema": {
        "properties": {
          "shares_path": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "mutation_class": "write",
      "op": "combine",
      "required_capability": "bin.shamir.combine"
    }
  ],
  "description": "Audited Trezor SLIP-0039 mnemonic share split/combine for vault-root splitting.",
  "name": "bin-shamir",
  "receipt_policy": {
    "algorithm": "sha256",
    "chain": true,
    "content_addressed": true
  },
  "schema_version": "1",
  "transports": [
    "unix_socket"
  ],
  "version": "1.0.0"
}
